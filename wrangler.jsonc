{
  "name": "singularitydsa",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "dsa.singularitymachines.si",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "ai": {
    "binding": "AI"
  },
  "main": "./src/worker.js",
  "ratelimits": [
    {
      "name": "TUTOR_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
